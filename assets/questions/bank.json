      "where": [
        "gcd(m, n) == 1",
        "c <= 60",
        "a != b"
      ],
      "text": "Find the length $x$.",
      "answer": "$x = [[c]]\\text{ cm}$",
      "diagram": {
        "kind": "right-triangle",
        "base": "[[b]] cm",
        "height": "[[a]] cm",
        "hyp": null,
        "unknown": "x"
      },
      "check": [
        "a * a + b * b == c * c"
      ],
      "qtype": "fluency"
