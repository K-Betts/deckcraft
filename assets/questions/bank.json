    {
      "id": "geo-t-001",
      "topic": "Geometry",
      "subtopic": "Forming and solving equations: angles on a straight line",
      "difficulty": 3,
      "keywords": [
        "angles",
        "straight line",
        "form an equation",
        "solve",
        "algebra",
        "180"
      ],
      "vars": [
        [
          "p",
          {
            "int": [
              2,
              4
            ]
          }
        ],
        [
          "x",
          {
            "int": [
              "ceil(120 / (p + 1))",
              "floor(175 / (p + 1))"
            ]
          }
        ]
      ],
      "calc": [
        [
          "q",
          "180 - (p + 1) * x"
        ],
        [
          "first",
          "p * x"
        ],
        [
          "second",
          "x + q"
        ]
      ],
      "where": [
        "q >= 5",
        "q <= 60",
        "first >= 25",
        "second >= 25",
        "first != 90",
        "second != 90",
        "abs(first - 90) >= 12",
        "abs(second - 90) >= 12"
      ],
      "text": "The angles lie on a straight line. Form and solve an equation to find $x$.",
      "answer": "$[[p+1|coef]]x + [[q]] = 180$, so $x = [[x]]$",
      "diagram": {
        "kind": "angles-line",
        "angles": [
          "$[[p|coef]]x$°",
          "$x + [[q]]$°"
        ],
        "sizes": [
          "[[first|n]]",
          "[[second|n]]"
        ],
        "unknown": "x"
      },
      "check": [
        "(p + 1) * x + q == 180"
      ],
      "qtype": "reasoning"
    },
